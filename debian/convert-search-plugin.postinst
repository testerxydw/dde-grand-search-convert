#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# 安装/升级后处理：重启 dde-grand-search-daemon，使其加载新版插件。
# 采用「尽力而为」策略，任何一步失败都不阻断安装（返回 0）。

set -e

restart_daemon() {
    # 优先通过 session bus 调用 daemon 重启/重载（若存在）
    if command -v dbus-send >/dev/null 2>&1; then
        dbus-send --session --dest=org.deepin.dde.GrandSearchDaemon \
            --type=method_call /org/deepin/dde/GrandSearchDaemon \
            org.deepin.dde.GrandSearchDaemon.Restart 2>/dev/null || true
        dbus-send --session --dest=org.deepin.dde.GrandSearchDaemon1 \
            --type=method_call /org/deepin/dde/GrandSearchDaemon1 \
            org.deepin.dde.GrandSearchDaemon1.Reload 2>/dev/null || true
    fi

    # 兜底：向已运行的 daemon 进程发 HUP，让其重新加载插件
    if command -v pkill >/dev/null 2>&1; then
        pkill -HUP -x dde-grand-search-daemon 2>/dev/null || true
    fi
}

case "$1" in
    configure)
        restart_daemon
        ;;
esac

exit 0
